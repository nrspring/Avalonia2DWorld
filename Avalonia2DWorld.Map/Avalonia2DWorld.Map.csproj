<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <!-- ISkiaSharpApiLeaseFeature: lets the control draw onto Avalonia's own SKCanvas
         rather than blitting a bitmap. Pins SkiaSharp 2.88.8, matching the ref below. -->
    <PackageReference Include="Avalonia.Skia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <!-- For MapViewModelBase: the same observable-property and command generators the view
         models above this library use, so an app does not meet two MVVM conventions in one
         code base. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
