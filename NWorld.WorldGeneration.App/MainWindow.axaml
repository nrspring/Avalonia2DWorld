<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="using:NWorld.Map.Viewer"
        xmlns:vm="using:NWorld.WorldGeneration.App.ViewModels"
        x:Class="NWorld.WorldGeneration.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NWorld World Generation"
        Width="1280"
        Height="800"
        WindowState="Maximized"
        Background="#11151B">
  <Window.Styles>
    <Style Selector="FlyoutPresenter.world-menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ProgressBar.execution-progress">
      <Setter Property="Height" Value="4" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="IsIndeterminate" Value="True" />
      <Setter Property="Foreground" Value="#67B7F7" />
      <Setter Property="Background" Value="#26313E" />
    </Style>
  </Window.Styles>

  <Grid Background="#11151B">
    <viewer:TileMapControl Tiles="{Binding Tiles}"
                           Adornments="{Binding Adornments}"
                           Highlights="{Binding Highlights}"
                           FitMapOnTilesChanged="True"
                           ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}"
                           PanUpperRow="{Binding PanUpperRow, Mode=TwoWay}"
                           PanLeftColumn="{Binding PanLeftColumn, Mode=TwoWay}"
                           PanHeightRows="{Binding PanHeightRows, Mode=TwoWay}"
                           PanWidthColumns="{Binding PanWidthColumns, Mode=TwoWay}"
                           ShowMiniMap="{Binding ShowMiniMap, Mode=TwoWay}"
                           DisplayMode="{Binding MapDisplayMode, Mode=TwoWay}"
                           IsPaintInteractionEnabled="{Binding IsPaintModeEnabled, Mode=TwoWay}"
                           TilePaintStartedCommand="{Binding BeginPaintCommand}"
                           TilePaintedCommand="{Binding PaintTileCommand}"
                           TilePaintCompletedCommand="{Binding CompletePaintCommand}"
                           HoveredTile="{Binding HoveredTile, Mode=OneWayToSource}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Margin="14"
                Spacing="10">
      <Button Padding="0"
              Background="Transparent"
              BorderThickness="0">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft"
                  FlyoutPresenterClasses="world-menu">
            <Border Width="420"
                    Background="#F0181C24"
                    BorderBrush="#34404D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14">
              <ScrollViewer MaxHeight="620"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Map Generator"
                               Foreground="#F2F5F8"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Generate continents first, then optionally sprinkle smaller islands into the surrounding water."
                               Foreground="#96A4B3"
                               FontSize="12"
                               TextWrapping="Wrap" />
                  </StackPanel>

                  <Border Background="#221F2630"
                          BorderBrush="#2E3744"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12,10">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Size"
                                   Foreground="#E7EDF5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Set the generated tile dimensions."
                                   Foreground="#8E9BAA"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,*"
                            ColumnSpacing="10">
                        <StackPanel Spacing="4"
                                    ToolTip.Tip="Controls how many tile columns are generated. Larger widths create broader maps but take more memory and rendering work.">
                          <TextBlock Text="Width"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding MapWidthText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    ToolTip.Tip="Controls how many tile rows are generated. Larger heights create taller maps but take more memory and rendering work.">
                          <TextBlock Text="Height"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding MapHeightText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Background="#221F2630"
                          BorderBrush="#2E3744"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12,10">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Seed"
                                   Foreground="#E7EDF5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Use a fixed seed for repeatable terrain or randomize it for a new pass."
                                   Foreground="#8E9BAA"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">
                        <TextBox Text="{Binding NoiseSeedText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center"
                                 ToolTip.Tip="Changes the random starting point. The same seed and settings reproduce the same land and water pattern." />
                        <Button Grid.Column="1"
                                Command="{Binding RandomizeSeedCommand}"
                                Background="#23303D"
                                BorderBrush="#425262"
                                Foreground="#EEF3F7"
                                Content="Randomize"
                                ToolTip.Tip="Picks a new seed so the next generated terrain has a different overall shape." />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Background="#221F2630"
                          BorderBrush="#2E3744"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12,10">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Continents"
                                   Foreground="#E7EDF5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Create the large base landmasses. Small detached land components are removed from this pass."
                                   Foreground="#8E9BAA"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,*,*"
                            ColumnSpacing="10">
                        <StackPanel Spacing="4"
                                    ToolTip.Tip="Sets the scale of continent and ocean shapes. Lower values create broader landmasses; higher values create tighter, busier coastlines.">
                          <TextBlock Text="Shape Scale"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding NoiseFrequencyText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    ToolTip.Tip="Sets how much of the map falls below land level. Higher values create more ocean and shoreline; lower values create more land.">
                          <TextBlock Text="Water Level %"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding NoiseWaterLevelText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="4"
                                    ToolTip.Tip="Width, in tiles, of channels carved between the largest separate water bodies. Use 0 for no cuts.">
                          <TextBlock Text="Cut Width"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding NoiseMinimumWaterConnectionWidthText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Background="#221F2630"
                          BorderBrush="#2E3744"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12,10">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Noise Shape"
                                   Foreground="#E7EDF5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Fine-tune the fractal simplex recipe used to form the continent pass."
                                   Foreground="#8E9BAA"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="10">
                        <StackPanel Spacing="4"
                                    ToolTip.Tip="Fractal gives smoother continent shapes. Billow makes rounder blobs. Ridged emphasizes seams and sharper bands.">
                          <TextBlock Text="Blend"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <ComboBox ItemsSource="{Binding NoiseBlendModes}"
                                    SelectedItem="{Binding NoiseBlendMode, Mode=TwoWay}"
                                    Background="#1C232D"
                                    BorderBrush="#374453"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    ToolTip.Tip="Number of stacked noise layers. More octaves add coastline detail; fewer octaves keep continent shapes simpler.">
                          <TextBlock Text="Octaves"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding NoiseOctavesText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="4"
                                    ToolTip.Tip="How strongly each smaller noise layer contributes. Higher values add more roughness and island detail.">
                          <TextBlock Text="Persistence"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding NoisePersistenceText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Spacing="4"
                                    ToolTip.Tip="How quickly detail frequency increases between octaves. Higher values add tighter secondary features.">
                          <TextBlock Text="Lacunarity"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding NoiseLacunarityText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="4"
                                    ToolTip.Tip="Curves the final noise values. Higher values shrink land into stronger peaks and separate water more aggressively.">
                          <TextBlock Text="Exponent"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding NoiseExponentText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="2"
                                    Spacing="4"
                                    ToolTip.Tip="Adds or subtracts from the final noise before thresholding. Positive creates more land; negative creates more water.">
                          <TextBlock Text="Height Bias"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding NoiseHeightBiasText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Background="#221F2630"
                          BorderBrush="#2E3744"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12,10">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="14">
                        <StackPanel Spacing="2"
                                    ToolTip.Tip="When enabled, map edges are pulled down toward water so continents cluster toward the center.">
                          <TextBlock Text="Edge Falloff"
                                     Foreground="#E7EDF5"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="Fade the map edges down toward water for contained continent layouts."
                                     Foreground="#8E9BAA"
                                     FontSize="11"
                                     TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding NoiseIslandFalloffEnabled, Mode=TwoWay}"
                                      OnContent="On"
                                      OffContent="Off"
                                      VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="*,*"
                            ColumnSpacing="10">
                        <StackPanel Spacing="4"
                                    ToolTip.Tip="Controls how strongly edge falloff suppresses continent land near map edges. 0 disables the effect; 1 strongly pulls edges into water.">
                          <TextBlock Text="Strength"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding NoiseIslandStrengthText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    ToolTip.Tip="Controls the curve of the edge falloff. Higher values keep the center larger before dropping edges into water.">
                          <TextBlock Text="Falloff Exp."
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding NoiseFalloffExponentText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <StackPanel Spacing="4">
                    <Button Command="{Binding GenerateMapCommand}"
                            Background="#26313E"
                            BorderBrush="#445262"
                            Foreground="#EEF3F7"
                            HorizontalAlignment="Stretch"
                            Content="Generate Continents"
                            ToolTip.Tip="Creates a new continent map using the current terrain settings. Water tiles are elevation 0 and continent land tiles are elevation 1." />
                    <ProgressBar Classes="execution-progress"
                                 IsVisible="{Binding IsGenerateMapRunning}" />
                  </StackPanel>

                  <Border Background="#221F2630"
                          BorderBrush="#2E3744"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12,10">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Sprinkle Islands"
                                   Foreground="#E7EDF5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Add small and medium detached land blobs after the continent pass."
                                   Foreground="#8E9BAA"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="10">
                        <StackPanel Spacing="4"
                                    ToolTip.Tip="Controls how many island centers are attempted. Some may be skipped if there is not enough open water.">
                          <TextBlock Text="Island Count"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding IslandCountText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    ToolTip.Tip="Controls deterministic island placement. The same seed and island settings reproduce the same island sprinkle pass.">
                          <TextBlock Text="Island Seed"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <Grid ColumnDefinitions="*,Auto"
                                ColumnSpacing="8">
                            <TextBox Text="{Binding IslandSeedText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                            <Button Grid.Column="1"
                                    Command="{Binding RandomizeIslandSeedCommand}"
                                    Background="#23303D"
                                    BorderBrush="#425262"
                                    Foreground="#EEF3F7"
                                    Content="Randomize"
                                    ToolTip.Tip="Picks a new island seed without changing the continent seed." />
                          </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Spacing="4"
                                    ToolTip.Tip="Sets the smallest island radius in tiles. Lower values create more tiny islands.">
                          <TextBlock Text="Min Radius"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding IslandMinimumRadiusText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="4"
                                    ToolTip.Tip="Sets the largest island radius in tiles. Higher values create more medium islands mixed into the sprinkle pass.">
                          <TextBlock Text="Max Radius"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding IslandMaximumRadiusText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Spacing="4"
                                    ToolTip.Tip="Controls shoreline roughness for sprinkled islands. Higher values make less circular islands.">
                          <TextBlock Text="Irregularity %"
                                     Foreground="#9AA7B5"
                                     FontSize="11" />
                          <TextBox Text="{Binding IslandIrregularityText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                        </StackPanel>
                      </Grid>

                      <StackPanel Spacing="4">
                        <Button Command="{Binding SprinkleIslandsCommand}"
                                Background="#26313E"
                                BorderBrush="#445262"
                                Foreground="#EEF3F7"
                                HorizontalAlignment="Stretch"
                                Content="Sprinkle Islands"
                                ToolTip.Tip="Adds island land tiles into existing water using the island count, seed, radius, and irregularity settings." />
                        <ProgressBar Classes="execution-progress"
                                     IsVisible="{Binding IsSprinkleIslandsRunning}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Background="#221F2630"
                          BorderBrush="#2E3744"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="12,10">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="2">
                        <TextBlock Text="File"
                                   Foreground="#E7EDF5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Save or load the map data together with the current generator settings."
                                   Foreground="#8E9BAA"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,*"
                            ColumnSpacing="10">
                        <StackPanel Spacing="4">
                          <Button Command="{Binding LoadMapCommand}"
                                  Background="#26313E"
                                  BorderBrush="#445262"
                                  Foreground="#EEF3F7"
                                  HorizontalAlignment="Stretch"
                                  Content="Load"
                                  ToolTip.Tip="Open a saved map document and restore its map data and generator settings." />
                          <ProgressBar Classes="execution-progress"
                                       IsVisible="{Binding IsLoadMapRunning}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Spacing="4">
                          <Button Command="{Binding SaveMapCommand}"
                                  Background="#26313E"
                                  BorderBrush="#445262"
                                  Foreground="#EEF3F7"
                                  HorizontalAlignment="Stretch"
                                  Content="Save"
                                  ToolTip.Tip="Save the current map data and generator settings. The save dialog starts with a timestamped file name." />
                          <ProgressBar Classes="execution-progress"
                                       IsVisible="{Binding IsSaveMapRunning}" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="{Binding GenerationStatus}"
                             Foreground="#90A0B0"
                             FontSize="11"
                             TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Flyout>
        </Button.Flyout>

        <Border Background="#D4141820"
                BorderBrush="#3A4450"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
            <Border Width="28"
                    Height="28"
                    CornerRadius="14"
                    Background="#26303B"
                    VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#DCE4EC"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="M" />
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="1">
              <TextBlock Text="Map"
                         Foreground="#F2F5F8"
                         FontSize="13"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding MapMenuSummary}"
                         Foreground="#93A3B2"
                         FontSize="11" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#B9C4CF"
                       FontSize="12"
                       Text="v" />
          </Grid>
        </Border>
      </Button>

      <Button Padding="0"
              Background="Transparent"
              BorderThickness="0">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft"
                  FlyoutPresenterClasses="world-menu">
            <Border Width="380"
                    Background="#F0181C24"
                    BorderBrush="#34404D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14">
              <ScrollViewer MaxHeight="760"
                            VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Resources"
                             Foreground="#F2F5F8"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Place harvestable map resources. Trees and deposits only fill empty resource tiles."
                             Foreground="#96A4B3"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="#221F2630"
                        BorderBrush="#2E3744"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Trees"
                                 Foreground="#E7EDF5"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Forests only grow on land and hills. Path frequency cuts open breaks through dense tree regions."
                                 Foreground="#8E9BAA"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">
                      <StackPanel Spacing="4"
                                  ToolTip.Tip="Controls how many forest regions are planned. Some may overlap or be skipped if there is not enough eligible land.">
                        <TextBlock Text="Forest Count"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding ForestCountText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls deterministic forest placement. The same seed and forest settings reproduce the same tree pass.">
                        <TextBlock Text="Forest Seed"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                          <TextBox Text="{Binding ForestSeedText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                          <Button Grid.Column="1"
                                  Command="{Binding RandomizeForestSeedCommand}"
                                  Background="#23303D"
                                  BorderBrush="#425262"
                                  Foreground="#EEF3F7"
                                  Content="Randomize"
                                  ToolTip.Tip="Picks a new forest seed without changing the rest of the map settings." />
                        </Grid>
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls how filled-in each forest region becomes. Higher density creates thicker forests.">
                        <TextBlock Text="Density %"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding ForestDensityText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls how wide forest regions spread from their center line.">
                        <TextBlock Text="Width"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding ForestWidthText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  Spacing="4"
                                  ToolTip.Tip="Controls how often open paths interrupt forest regions, similar to passes through mountains.">
                        <TextBlock Text="Path Frequency %"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding ForestPassFrequencyText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                      <Button Command="{Binding GenerateForestsCommand}"
                              Background="#26313E"
                              BorderBrush="#445262"
                              Foreground="#EEF3F7"
                              HorizontalAlignment="Stretch"
                              Content="Place Trees"
                              ToolTip.Tip="Places forest resources on eligible land and hill tiles while avoiding water and mountain elevations." />
                      <ProgressBar Classes="execution-progress"
                                   IsVisible="{Binding IsGenerateForestsRunning}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Background="#221F2630"
                        BorderBrush="#2E3744"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Deposits"
                                 Foreground="#E7EDF5"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Iron, stone, coal, and rare metals are placed as small additive deposits on eligible land."
                                 Foreground="#8E9BAA"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                      <StackPanel Spacing="6"
                                  ToolTip.Tip="Iron prefers hills and mountains but can appear on lower land.">
                        <TextBlock Text="Iron"
                                   Foreground="#DDE7F0"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Seed"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                              <TextBox Text="{Binding IronSeedText, Mode=TwoWay}"
                                       Background="#1C232D"
                                       BorderBrush="#374453"
                                       HorizontalContentAlignment="Center" />
                              <Button Grid.Column="1"
                                      Command="{Binding RandomizeIronSeedCommand}"
                                      Background="#23303D"
                                      BorderBrush="#425262"
                                      Foreground="#EEF3F7"
                                      Content="Randomize" />
                            </Grid>
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Count"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding IronCountText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Density %"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding IronDensityText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Width"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding IronWidthText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                        </Grid>
                        <Button Command="{Binding GenerateIronDepositsCommand}"
                                Background="#26313E"
                                BorderBrush="#445262"
                                Foreground="#EEF3F7"
                                HorizontalAlignment="Stretch"
                                Content="Place Iron" />
                        <ProgressBar Classes="execution-progress"
                                     IsVisible="{Binding IsGenerateIronDepositsRunning}" />
                      </StackPanel>

                      <Border Height="1"
                              Background="#2E3744" />

                      <StackPanel Spacing="6"
                                  ToolTip.Tip="Stone can appear on land, hills, and mountains, with higher odds in rougher terrain.">
                        <TextBlock Text="Stone"
                                   Foreground="#DDE7F0"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Seed"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                              <TextBox Text="{Binding StoneSeedText, Mode=TwoWay}"
                                       Background="#1C232D"
                                       BorderBrush="#374453"
                                       HorizontalContentAlignment="Center" />
                              <Button Grid.Column="1"
                                      Command="{Binding RandomizeStoneSeedCommand}"
                                      Background="#23303D"
                                      BorderBrush="#425262"
                                      Foreground="#EEF3F7"
                                      Content="Randomize" />
                            </Grid>
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Count"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding StoneCountText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Density %"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding StoneDensityText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Width"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding StoneWidthText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                        </Grid>
                        <Button Command="{Binding GenerateStoneDepositsCommand}"
                                Background="#26313E"
                                BorderBrush="#445262"
                                Foreground="#EEF3F7"
                                HorizontalAlignment="Stretch"
                                Content="Place Stone" />
                        <ProgressBar Classes="execution-progress"
                                     IsVisible="{Binding IsGenerateStoneDepositsRunning}" />
                      </StackPanel>

                      <Border Height="1"
                              Background="#2E3744" />

                      <StackPanel Spacing="6"
                                  ToolTip.Tip="Coal prefers land and hills, and is less likely on mountain peaks.">
                        <TextBlock Text="Coal"
                                   Foreground="#DDE7F0"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Seed"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                              <TextBox Text="{Binding CoalSeedText, Mode=TwoWay}"
                                       Background="#1C232D"
                                       BorderBrush="#374453"
                                       HorizontalContentAlignment="Center" />
                              <Button Grid.Column="1"
                                      Command="{Binding RandomizeCoalSeedCommand}"
                                      Background="#23303D"
                                      BorderBrush="#425262"
                                      Foreground="#EEF3F7"
                                      Content="Randomize" />
                            </Grid>
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Count"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding CoalCountText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Density %"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding CoalDensityText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Width"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding CoalWidthText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                        </Grid>
                        <Button Command="{Binding GenerateCoalDepositsCommand}"
                                Background="#26313E"
                                BorderBrush="#445262"
                                Foreground="#EEF3F7"
                                HorizontalAlignment="Stretch"
                                Content="Place Coal" />
                        <ProgressBar Classes="execution-progress"
                                     IsVisible="{Binding IsGenerateCoalDepositsRunning}" />
                      </StackPanel>

                      <Border Height="1"
                              Background="#2E3744" />

                      <StackPanel Spacing="6"
                                  ToolTip.Tip="Rare metals only appear in high elevations, with the strongest preference for mountains.">
                        <TextBlock Text="Rare Metals"
                                   Foreground="#DDE7F0"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Seed"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                              <TextBox Text="{Binding RareMetalsSeedText, Mode=TwoWay}"
                                       Background="#1C232D"
                                       BorderBrush="#374453"
                                       HorizontalContentAlignment="Center" />
                              <Button Grid.Column="1"
                                      Command="{Binding RandomizeRareMetalsSeedCommand}"
                                      Background="#23303D"
                                      BorderBrush="#425262"
                                      Foreground="#EEF3F7"
                                      Content="Randomize" />
                            </Grid>
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Count"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding RareMetalsCountText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Density %"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding RareMetalsDensityText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Spacing="4">
                            <TextBlock Text="Width"
                                       Foreground="#9AA7B5"
                                       FontSize="11" />
                            <TextBox Text="{Binding RareMetalsWidthText, Mode=TwoWay}"
                                     Background="#1C232D"
                                     BorderBrush="#374453"
                                     HorizontalContentAlignment="Center" />
                          </StackPanel>
                        </Grid>
                        <Button Command="{Binding GenerateRareMetalsDepositsCommand}"
                                Background="#26313E"
                                BorderBrush="#445262"
                                Foreground="#EEF3F7"
                                HorizontalAlignment="Stretch"
                                Content="Place Rare Metals" />
                        <ProgressBar Classes="execution-progress"
                                     IsVisible="{Binding IsGenerateRareMetalsDepositsRunning}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding GenerationStatus}"
                           Foreground="#90A0B0"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
              </ScrollViewer>
            </Border>
          </Flyout>
        </Button.Flyout>

        <Border Background="#D4141820"
                BorderBrush="#3A4450"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
            <Border Width="28"
                    Height="28"
                    CornerRadius="14"
                    Background="#26303B"
                    VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#DCE4EC"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="T" />
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="1">
              <TextBlock Text="Resources"
                         Foreground="#F2F5F8"
                         FontSize="13"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding ResourcesMenuSummary}"
                         Foreground="#93A3B2"
                         FontSize="11" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#B9C4CF"
                       FontSize="12"
                       Text="v" />
          </Grid>
        </Border>
      </Button>

      <Button Padding="0"
              Background="Transparent"
              BorderThickness="0">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft"
                  FlyoutPresenterClasses="world-menu">
            <Border Width="380"
                    Background="#F0181C24"
                    BorderBrush="#34404D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Rivers"
                             Foreground="#F2F5F8"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Start rivers in hills and let them wander by cardinal turns toward sea, lakes, or other rivers."
                             Foreground="#96A4B3"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="#221F2630"
                        BorderBrush="#2E3744"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="River Placement"
                                 Foreground="#E7EDF5"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Rivers use only north, east, south, and west steps, so bends are 90 degree turns."
                                 Foreground="#8E9BAA"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">
                      <StackPanel Spacing="4"
                                  ToolTip.Tip="Controls how many river paths are attempted. Some may be skipped if no hill start can reach water.">
                        <TextBlock Text="River Count"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding RiverCountText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls deterministic river placement. The same seed and river settings reproduce the same river pass.">
                        <TextBlock Text="River Seed"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                          <TextBox Text="{Binding RiverSeedText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                          <Button Grid.Column="1"
                                  Command="{Binding RandomizeRiverSeedCommand}"
                                  Background="#23303D"
                                  BorderBrush="#425262"
                                  Foreground="#EEF3F7"
                                  Content="Randomize"
                                  ToolTip.Tip="Picks a new river seed without changing the rest of the map settings." />
                        </Grid>
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls how much rivers wander away from the most direct route to water. Higher values create more bends.">
                        <TextBlock Text="Wander %"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding RiverWanderText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls how often rivers widen into a neighboring cardinal tile. Rivers remain mostly one tile wide.">
                        <TextBlock Text="Widening %"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding RiverWideningText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  Spacing="4"
                                  ToolTip.Tip="Controls what percentage of rivers try to terminate in sea water instead of allowing lakes or existing rivers as endpoints.">
                        <TextBlock Text="Sea Termination %"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding RiverSeaTerminationText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                      <Button Command="{Binding GenerateRiversCommand}"
                              Background="#26313E"
                              BorderBrush="#445262"
                              Foreground="#EEF3F7"
                              HorizontalAlignment="Stretch"
                              Content="Create Rivers"
                              ToolTip.Tip="Creates rivers that start in hill areas and end when they reach sea, lakes, or existing river water." />
                      <ProgressBar Classes="execution-progress"
                                   IsVisible="{Binding IsGenerateRiversRunning}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding GenerationStatus}"
                           Foreground="#90A0B0"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>

        <Border Background="#D4141820"
                BorderBrush="#3A4450"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
            <Border Width="28"
                    Height="28"
                    CornerRadius="14"
                    Background="#26303B"
                    VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#DCE4EC"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="R" />
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="1">
              <TextBlock Text="Rivers"
                         Foreground="#F2F5F8"
                         FontSize="13"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding RiversMenuSummary}"
                         Foreground="#93A3B2"
                         FontSize="11" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#B9C4CF"
                       FontSize="12"
                       Text="v" />
          </Grid>
        </Border>
      </Button>

      <Button Padding="0"
              Background="Transparent"
              BorderThickness="0">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft"
                  FlyoutPresenterClasses="world-menu">
            <Border Width="380"
                    Background="#F0181C24"
                    BorderBrush="#34404D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Lakes"
                             Foreground="#F2F5F8"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Place inland lakes on land and hill tiles without touching sea water or mountains."
                             Foreground="#96A4B3"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="#221F2630"
                        BorderBrush="#2E3744"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Lake Placement"
                                 Foreground="#E7EDF5"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Each accepted lake replaces land or hills and keeps the lowest elevation from its footprint."
                                 Foreground="#8E9BAA"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">
                      <StackPanel Spacing="4"
                                  ToolTip.Tip="Controls how many inland lakes are attempted. Some may be skipped when land is too close to sea water or mountains.">
                        <TextBlock Text="Lake Count"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding LakeCountText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls deterministic lake placement. The same seed and lake settings reproduce the same lake pass.">
                        <TextBlock Text="Lake Seed"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                          <TextBox Text="{Binding LakeSeedText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                          <Button Grid.Column="1"
                                  Command="{Binding RandomizeLakeSeedCommand}"
                                  Background="#23303D"
                                  BorderBrush="#425262"
                                  Foreground="#EEF3F7"
                                  Content="Randomize"
                                  ToolTip.Tip="Picks a new lake seed without changing the rest of the map settings." />
                        </Grid>
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Spacing="4"
                                  ToolTip.Tip="Sets the smallest lake radius in tiles. Lower values fit more lakes into inland gaps.">
                        <TextBlock Text="Min Radius"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding LakeMinimumRadiusText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  Spacing="4"
                                  ToolTip.Tip="Sets the largest lake radius in tiles. Higher values need larger inland areas away from sea and mountains.">
                        <TextBlock Text="Max Radius"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding LakeMaximumRadiusText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  Spacing="4"
                                  ToolTip.Tip="Controls shoreline roughness for lakes. Higher values make the lake edges less circular.">
                        <TextBlock Text="Irregularity %"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding LakeIrregularityText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                      <Button Command="{Binding GenerateLakesCommand}"
                              Background="#26313E"
                              BorderBrush="#445262"
                              Foreground="#EEF3F7"
                              HorizontalAlignment="Stretch"
                              Content="Place Lakes"
                              ToolTip.Tip="Places inland lakes only on land and hill tiles. Lakes are rejected if they touch existing water or mountains." />
                      <ProgressBar Classes="execution-progress"
                                   IsVisible="{Binding IsGenerateLakesRunning}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding GenerationStatus}"
                           Foreground="#90A0B0"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>

        <Border Background="#D4141820"
                BorderBrush="#3A4450"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
            <Border Width="28"
                    Height="28"
                    CornerRadius="14"
                    Background="#26303B"
                    VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#DCE4EC"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="L" />
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="1">
              <TextBlock Text="Lakes"
                         Foreground="#F2F5F8"
                         FontSize="13"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding LakesMenuSummary}"
                         Foreground="#93A3B2"
                         FontSize="11" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#B9C4CF"
                       FontSize="12"
                       Text="v" />
          </Grid>
        </Border>
      </Button>

      <Button Padding="0"
              Background="Transparent"
              BorderThickness="0">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft"
                  FlyoutPresenterClasses="world-menu">
            <Border Width="340"
                    Background="#F0181C24"
                    BorderBrush="#34404D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Paint"
                             Foreground="#F2F5F8"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Paint direct terrain adjustments onto the map."
                             Foreground="#96A4B3"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="#221F2630"
                        BorderBrush="#2E3744"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="14">
                      <StackPanel Spacing="2"
                                  ToolTip.Tip="When enabled, left-dragging paints map tiles. Use right mouse hold to pan the map.">
                        <TextBlock Text="Paint Mode"
                                   Foreground="#E7EDF5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Enable painting, then drag over tiles in the map workspace."
                                   Foreground="#8E9BAA"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <ToggleSwitch Grid.Column="1"
                                    IsChecked="{Binding IsPaintModeEnabled, Mode=TwoWay}"
                                    OnContent="On"
                                    OffContent="Off"
                                    VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Spacing="4"
                                ToolTip.Tip="Choose what tile type the brush applies. Shallow Water marks tiles as coastal water. Hill marks tiles as land at hill elevation 2.">
                      <TextBlock Text="Brush"
                                 Foreground="#9AA7B5"
                                 FontSize="11" />
                      <ComboBox ItemsSource="{Binding PaintTools}"
                                SelectedItem="{Binding PaintTool, Mode=TwoWay}"
                                Background="#1C232D"
                                BorderBrush="#374453"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding PaintMenuSummary}"
                           Foreground="#90A0B0"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>

        <Border Background="#D4141820"
                BorderBrush="#3A4450"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
            <Border Width="28"
                    Height="28"
                    CornerRadius="14"
                    Background="#26303B"
                    VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#DCE4EC"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="P" />
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="1">
              <TextBlock Text="Paint"
                         Foreground="#F2F5F8"
                         FontSize="13"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding PaintMenuSummary}"
                         Foreground="#93A3B2"
                         FontSize="11" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#B9C4CF"
                       FontSize="12"
                       Text="v" />
          </Grid>
        </Border>
      </Button>

      <Button Padding="0"
              Background="Transparent"
              BorderThickness="0">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft"
                  FlyoutPresenterClasses="world-menu">
            <Border Width="340"
                    Background="#F0181C24"
                    BorderBrush="#34404D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="View"
                             Foreground="#F2F5F8"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Change how the terrain is visualized without changing map data."
                             Foreground="#96A4B3"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="#221F2630"
                        BorderBrush="#2E3744"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Display"
                                 Foreground="#E7EDF5"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="HeatMap uses black water, dark green land and dark red mountains for quick elevation reading."
                                 Foreground="#8E9BAA"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4"
                                ToolTip.Tip="Switches the control between the natural terrain palette and a simplified heatmap palette. This does not alter the generated tiles.">
                      <TextBlock Text="Mode"
                                 Foreground="#9AA7B5"
                                 FontSize="11" />
                      <ComboBox ItemsSource="{Binding MapDisplayModes}"
                                SelectedItem="{Binding MapDisplayMode, Mode=TwoWay}"
                                Background="#1C232D"
                                BorderBrush="#374453"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding ShowMiniMap, Mode=TwoWay}"
                              Foreground="#DCE4EC"
                              Content="Show minimap"
                              ToolTip.Tip="Shows or hides the minimap overlay. The minimap also uses the selected display mode." />
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding ViewMenuSummary}"
                           Foreground="#90A0B0"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>

        <Border Background="#D4141820"
                BorderBrush="#3A4450"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
            <Border Width="28"
                    Height="28"
                    CornerRadius="14"
                    Background="#26303B"
                    VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#DCE4EC"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="V" />
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="1">
              <TextBlock Text="View"
                         Foreground="#F2F5F8"
                         FontSize="13"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding ViewMenuSummary}"
                         Foreground="#93A3B2"
                         FontSize="11" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#B9C4CF"
                       FontSize="12"
                       Text="v" />
          </Grid>
        </Border>
      </Button>

      <Button Padding="0"
              Background="Transparent"
              BorderThickness="0">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft"
                  FlyoutPresenterClasses="world-menu">
            <Border Width="340"
                    Background="#F0181C24"
                    BorderBrush="#34404D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Water"
                             Foreground="#F2F5F8"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Convert deep water near land into shallow coastal water."
                             Foreground="#96A4B3"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="#221F2630"
                        BorderBrush="#2E3744"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Shallow Water"
                                 Foreground="#E7EDF5"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Set how far shallow water extends outward from land."
                                 Foreground="#8E9BAA"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4"
                                ToolTip.Tip="Distance, in tiles, from land that should become shallow water. Water farther away remains deep water.">
                      <TextBlock Text="Shallow Water Buffer"
                                 Foreground="#9AA7B5"
                                 FontSize="11" />
                      <TextBox Text="{Binding ShallowWaterBufferText, Mode=TwoWay}"
                               Background="#1C232D"
                               BorderBrush="#374453"
                               HorizontalContentAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                  <Button Command="{Binding ApplyShallowWaterBufferCommand}"
                          Background="#26313E"
                          BorderBrush="#445262"
                          Foreground="#EEF3F7"
                          HorizontalAlignment="Stretch"
                          Content="Apply Shallow Water"
                          ToolTip.Tip="Changes all water within the buffer distance from land to shallow water. Other water remains deep water." />
                  <ProgressBar Classes="execution-progress"
                               IsVisible="{Binding IsApplyShallowWaterRunning}" />
                </StackPanel>

                <TextBlock Text="{Binding GenerationStatus}"
                           Foreground="#90A0B0"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>

        <Border Background="#D4141820"
                BorderBrush="#3A4450"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
            <Border Width="28"
                    Height="28"
                    CornerRadius="14"
                    Background="#26303B"
                    VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#DCE4EC"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="W" />
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="1">
              <TextBlock Text="Water"
                         Foreground="#F2F5F8"
                         FontSize="13"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding WaterMenuSummary}"
                         Foreground="#93A3B2"
                         FontSize="11" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#B9C4CF"
                       FontSize="12"
                       Text="v" />
          </Grid>
        </Border>
      </Button>

      <Button Padding="0"
              Background="Transparent"
              BorderThickness="0">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft"
                  FlyoutPresenterClasses="world-menu">
            <Border Width="380"
                    Background="#F0181C24"
                    BorderBrush="#34404D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14">
              <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                  <TextBlock Text="Hills"
                             Foreground="#F2F5F8"
                             FontSize="15"
                             FontWeight="SemiBold" />
                  <TextBlock Text="Raise rolling hill ranges, then create mountain ranges inside hill areas."
                             Foreground="#96A4B3"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="#221F2630"
                        BorderBrush="#2E3744"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Hill Ranges"
                                 Foreground="#E7EDF5"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Hills raise land from elevation 2 through 10, fading near shorelines."
                                 Foreground="#8E9BAA"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">
                      <StackPanel Spacing="4"
                                  ToolTip.Tip="Controls how many separate hill ranges are planned. More ranges create more elevated regions across the land.">
                        <TextBlock Text="Range Count"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding HillRangeCountText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls deterministic hill placement. The same seed and hill settings reproduce the same ranges.">
                        <TextBlock Text="Hill Seed"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                          <TextBox Text="{Binding HillSeedText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                          <Button Grid.Column="1"
                                  Command="{Binding RandomizeHillSeedCommand}"
                                  Background="#23303D"
                                  BorderBrush="#425262"
                                  Foreground="#EEF3F7"
                                  Content="Randomize"
                                  ToolTip.Tip="Picks a new hill seed without changing the base map seed." />
                        </Grid>
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls hill height. Higher values push more range centers toward elevation 10; lower values keep hills softer.">
                        <TextBlock Text="Strength"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding HillStrengthText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls how wide each range spreads from its centerline. Wider ranges raise more neighboring land tiles.">
                        <TextBlock Text="Width"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding HillWidthText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  Spacing="4"
                                  ToolTip.Tip="Controls how often soft passes interrupt hill ridges. Higher values create more low relief breaks through the ranges.">
                        <TextBlock Text="Pass Frequency %"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding HillPassFrequencyText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                  <Button Command="{Binding GenerateHillsCommand}"
                          Background="#26313E"
                          BorderBrush="#445262"
                          Foreground="#EEF3F7"
                          HorizontalAlignment="Stretch"
                          Content="Raise Hills"
                          ToolTip.Tip="Applies hill elevation to land only. Water remains elevation 0 and land hills are capped from elevation 2 to 10." />
                  <ProgressBar Classes="execution-progress"
                               IsVisible="{Binding IsGenerateHillsRunning}" />
                </StackPanel>

                <Border Background="#221F2630"
                        BorderBrush="#2E3744"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Mountains"
                                 Foreground="#E7EDF5"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="Mountain ranges raise existing hill tiles into high elevation ridges from 11 through 25."
                                 Foreground="#8E9BAA"
                                 FontSize="11"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">
                      <StackPanel Spacing="4"
                                  ToolTip.Tip="Controls how many mountain ridge lines are planned. Range centers are selected only from existing hill tiles.">
                        <TextBlock Text="Range Count"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding MountainPeakCountText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls deterministic mountain placement. The same seed and mountain settings reproduce the same ranges.">
                        <TextBlock Text="Mountain Seed"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                          <TextBox Text="{Binding MountainSeedText, Mode=TwoWay}"
                                   Background="#1C232D"
                                   BorderBrush="#374453"
                                   HorizontalContentAlignment="Center" />
                          <Button Grid.Column="1"
                                  Command="{Binding RandomizeMountainSeedCommand}"
                                  Background="#23303D"
                                  BorderBrush="#425262"
                                  Foreground="#EEF3F7"
                                  Content="Randomize"
                                  ToolTip.Tip="Picks a new mountain seed without changing the hill seed." />
                        </Grid>
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls mountain height. Higher values push ridges closer to elevation 25.">
                        <TextBlock Text="Strength"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding MountainStrengthText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>

                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  Spacing="4"
                                  ToolTip.Tip="Controls how far each mountain spreads from its centerline. Only existing hill tiles can be raised.">
                        <TextBlock Text="Width"
                                   Foreground="#9AA7B5"
                                   FontSize="11" />
                        <TextBox Text="{Binding MountainRadiusText, Mode=TwoWay}"
                                 Background="#1C232D"
                                 BorderBrush="#374453"
                                 HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                      <Button Command="{Binding GenerateMountainsCommand}"
                              Background="#26313E"
                              BorderBrush="#445262"
                              Foreground="#EEF3F7"
                              HorizontalAlignment="Stretch"
                              Content="Create Mountains"
                              ToolTip.Tip="Raises mountain ranges only within existing hill areas. Flat land and water are not eligible." />
                      <ProgressBar Classes="execution-progress"
                                   IsVisible="{Binding IsGenerateMountainsRunning}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding GenerationStatus}"
                           Foreground="#90A0B0"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Flyout>
        </Button.Flyout>

        <Border Background="#D4141820"
                BorderBrush="#3A4450"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12,8">
          <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">
            <Border Width="28"
                    Height="28"
                    CornerRadius="14"
                    Background="#26303B"
                    VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#DCE4EC"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="H" />
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="1">
              <TextBlock Text="Hills"
                         Foreground="#F2F5F8"
                         FontSize="13"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding HillsMenuSummary}"
                         Foreground="#93A3B2"
                         FontSize="11" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#B9C4CF"
                       FontSize="12"
                       Text="v" />
          </Grid>
        </Border>
      </Button>
    </StackPanel>

    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Margin="14"
                Spacing="10">
      <Button Command="{Binding UndoCommand}"
              IsEnabled="{Binding CanUndo}"
              Padding="12,8"
              Background="#D4141820"
              BorderBrush="#3A4450"
              BorderThickness="1"
              Foreground="#EEF3F7"
              ToolTip.Tip="Undo the last map-changing operation.">
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="10">
          <Border Width="28"
                  Height="28"
                  CornerRadius="14"
                  Background="#26303B"
                  VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#DCE4EC"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Text="U" />
          </Border>

          <StackPanel Grid.Column="1"
                      Spacing="1">
            <TextBlock Text="Undo"
                       Foreground="#F2F5F8"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <TextBlock Text="Walk back map changes"
                       Foreground="#93A3B2"
                       FontSize="11" />
          </StackPanel>
        </Grid>
      </Button>

      <Border Background="#D4141820"
              BorderBrush="#3A4450"
              BorderThickness="1"
              CornerRadius="14"
              Padding="12,8"
              ToolTip.Tip="Switches between terrain and heatmap rendering without changing map data.">
        <Grid ColumnDefinitions="Auto,150"
              ColumnSpacing="10"
              VerticalAlignment="Center">
          <TextBlock Text="View"
                     Foreground="#F2F5F8"
                     FontSize="13"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding MapDisplayModes}"
                    SelectedItem="{Binding MapDisplayMode, Mode=TwoWay}"
                    Background="#1C232D"
                    BorderBrush="#374453"
                    Foreground="#EEF3F7"
                    HorizontalAlignment="Stretch" />
        </Grid>
      </Border>

      <Border Background="#D4141820"
              BorderBrush="#3A4450"
              BorderThickness="1"
              CornerRadius="14"
              Padding="12,8">
        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <TextBlock Text="Paint"
                     Foreground="#F2F5F8"
                     FontSize="13"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <ToggleSwitch IsChecked="{Binding IsPaintModeEnabled, Mode=TwoWay}"
                        OnContent="On"
                        OffContent="Off"
                        VerticalAlignment="Center"
                        ToolTip.Tip="When enabled, left-dragging paints map tiles. Use right mouse hold to pan the map." />
          <ComboBox ItemsSource="{Binding PaintTools}"
                    SelectedItem="{Binding PaintTool, Mode=TwoWay}"
                    IsVisible="{Binding IsPaintModeEnabled}"
                    Background="#1C232D"
                    BorderBrush="#374453"
                    Foreground="#EEF3F7"
                    Width="150"
                    ToolTip.Tip="Choose what tile type the brush applies." />
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      IsVisible="{Binding IsIslandPaintOptionsVisible}">
            <StackPanel Spacing="2"
                        Width="64"
                        ToolTip.Tip="Smallest island radius in tiles for island painting.">
              <TextBlock Text="Min"
                         Foreground="#9AA7B5"
                         FontSize="10" />
              <TextBox Text="{Binding IslandMinimumRadiusText, Mode=TwoWay}"
                       Background="#1C232D"
                       BorderBrush="#374453"
                       Foreground="#EEF3F7"
                       HorizontalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="2"
                        Width="64"
                        ToolTip.Tip="Largest island radius in tiles for island painting.">
              <TextBlock Text="Max"
                         Foreground="#9AA7B5"
                         FontSize="10" />
              <TextBox Text="{Binding IslandMaximumRadiusText, Mode=TwoWay}"
                       Background="#1C232D"
                       BorderBrush="#374453"
                       Foreground="#EEF3F7"
                       HorizontalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="2"
                        Width="72"
                        ToolTip.Tip="Shoreline irregularity percentage for island painting.">
              <TextBlock Text="Irreg."
                         Foreground="#9AA7B5"
                         FontSize="10" />
              <TextBox Text="{Binding IslandIrregularityText, Mode=TwoWay}"
                       Background="#1C232D"
                       BorderBrush="#374453"
                       Foreground="#EEF3F7"
                       HorizontalContentAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      IsVisible="{Binding IsLakePaintOptionsVisible}">
            <StackPanel Spacing="2"
                        Width="64"
                        ToolTip.Tip="Smallest lake radius in tiles for lake painting.">
              <TextBlock Text="Min"
                         Foreground="#9AA7B5"
                         FontSize="10" />
              <TextBox Text="{Binding LakeMinimumRadiusText, Mode=TwoWay}"
                       Background="#1C232D"
                       BorderBrush="#374453"
                       Foreground="#EEF3F7"
                       HorizontalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="2"
                        Width="64"
                        ToolTip.Tip="Largest lake radius in tiles for lake painting.">
              <TextBlock Text="Max"
                         Foreground="#9AA7B5"
                         FontSize="10" />
              <TextBox Text="{Binding LakeMaximumRadiusText, Mode=TwoWay}"
                       Background="#1C232D"
                       BorderBrush="#374453"
                       Foreground="#EEF3F7"
                       HorizontalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Spacing="2"
                        Width="72"
                        ToolTip.Tip="Shoreline irregularity percentage for lake painting.">
              <TextBlock Text="Irreg."
                         Foreground="#9AA7B5"
                         FontSize="10" />
              <TextBox Text="{Binding LakeIrregularityText, Mode=TwoWay}"
                       Background="#1C232D"
                       BorderBrush="#374453"
                       Foreground="#EEF3F7"
                       HorizontalContentAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</Window>
