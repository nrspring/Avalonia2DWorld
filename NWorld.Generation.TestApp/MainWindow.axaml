<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NWorld.Generation.TestApp.ViewModels"
        xmlns:map="clr-namespace:NWorld.Map.Controls;assembly=NWorld.Map"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="NWorld.Generation.TestApp.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1000" Height="700"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#EEF3FA" />
        <SolidColorBrush x:Key="TextMuted" Color="#8492A6" />
        <SolidColorBrush x:Key="TextWarn" Color="#F0A742" />
    </Window.Resources>

    <Window.Styles>

        <!-- The same floating card the generation app uses, cut down to the one it needs.
             Copied rather than shared: the styles there are written against that window's
             resources and its accordion, and lifting them into a library to save nine lines
             would be the tail wagging the dog. -->
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#E6121A26" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="16" />
            <Setter Property="BoxShadow" Value="0 8 28 0 #40000000" />
        </Style>

        <Style Selector="TextBlock.note">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.note.warn">
            <Setter Property="Foreground" Value="{StaticResource TextWarn}" />
        </Style>

        <Style Selector="TextBlock.field">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Margin" Value="2,0,0,3" />
        </Style>

        <Style Selector="Border.rule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>

        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#4C8DFF" />
            <Setter Property="Foreground" Value="#0B1220" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Opening a world is the one thing this window cannot do without, so it gets the
             filled button. Saving and loading what was built on it are ordinary work and sit
             back a step, which is also what stops the card reading as three equal choices. -->
        <Style Selector="Button.minor">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

    </Window.Styles>

    <!-- The map fills the window and the one control floats over it, the same arrangement the
         generation app uses: this is a window onto a map, not a form with a map in it. -->
    <Panel Background="#0B1220">

        <map:MapView Tiles="{Binding Tiles}"
                     Renderer="{Binding Renderer}"
                     Options="{Binding Options}"
                     HoverCommand="{Binding HoverCommand}"
                     ClickCommand="{Binding ClickCommand}"
                     RightClickCommand="{Binding RightClickCommand}"
                     ZoomCommand="{Binding ZoomCommand}"
                     MiniMapCommand="{Binding MiniMapCommand}"
                     PanCommand="{Binding PanCommand}" />

        <Border Classes="card"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="220">

            <StackPanel Spacing="10">

                <Button Classes="primary"
                        Content="Open"
                        Click="OnLoadClick" />

                <TextBlock Classes="note"
                           Classes.warn="{Binding HasProblem}"
                           Text="{Binding Status}" />

                <Border Classes="rule" />

                <TextBlock Classes="field" Text="ENHANCEMENTS" />

                <!-- Off is one of the choices rather than a switch beside them, so that not
                     building, which is what this window is doing most of the time, is as
                     easy to reach as the ones that build. -->
                <StackPanel Spacing="6" IsEnabled="{Binding HasMap}">
                    <RadioButton Content="Off"
                                 GroupName="enhancement"
                                 IsChecked="{Binding IsBuildingNothing}" />
                    <RadioButton Content="Road"
                                 GroupName="enhancement"
                                 IsChecked="{Binding IsBuildingRoad}" />
                    <RadioButton Content="Bridge"
                                 GroupName="enhancement"
                                 IsChecked="{Binding IsBuildingBridge}" />
                    <RadioButton Content="City"
                                 GroupName="enhancement"
                                 IsChecked="{Binding IsBuildingCity}" />
                    <RadioButton Content="Fort"
                                 GroupName="enhancement"
                                 IsChecked="{Binding IsBuildingFort}" />
                </StackPanel>

                <TextBlock Classes="note" Text="{Binding BuildSummary}" />

                <!-- What was built is saved beside the world, never into it: the world is
                     finished when it is generated and this window only ever writes the layer
                     over it. The line above doubles as the report, since saving and loading
                     are the same subject as the clicks that made the thing being saved. -->
                <Grid ColumnDefinitions="*,8,*" IsEnabled="{Binding HasMap}">
                    <Button Grid.Column="0"
                            Classes="minor"
                            Content="Save built"
                            Click="OnSaveEnhancementsClick" />
                    <Button Grid.Column="2"
                            Classes="minor"
                            Content="Load built"
                            Click="OnLoadEnhancementsClick" />
                </Grid>

                <!-- Said here because there is nothing else on screen to discover it from:
                     the map takes the wheel and the right button, and neither is obvious on a
                     window with one button on it. -->
                <TextBlock Classes="note"
                           Text="Wheel zooms. Right-drag pans. The inset jumps." />

            </StackPanel>
        </Border>

    </Panel>

</Window>
